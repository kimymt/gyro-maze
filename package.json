{
  "name": "gyro-maze",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@scure/base": "^2.4.0",
    "light-bolt11-decoder": "^3.2.0",
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
